# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan
# `docker-compose up`. Jangan commit file ".env" yang sudah berisi rahasia asli.

# --- PostgreSQL ---
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://postgres:5432/pos_db
DB_USERNAME=pos_user
DB_PASSWORD=pos_password
# Kunci rahasia JWT - WAJIB diganti dengan string acak panjang (>= 32 karakter) di produksi.
JWT_SECRET=change-this-super-secret-key-please-override-in-env-min-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Identitas toko yang tercetak di struk
STORE_NAME=Toko Sederhana
STORE_ADDRESS=Jl. Contoh No. 123, Jakarta
STORE_PHONE=0812-3456-7890

# --- Frontend ---
# Port host untuk mengakses frontend (nginx container listens on 80 internally)
FRONTEND_PORT=8081
BACKEND_PORT=8080
